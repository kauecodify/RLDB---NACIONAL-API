# Dockerfile para AI Service (inferencia de modelos de IA/ML)
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch==2.0.1 \
    torchvision==0.15.2 \
    scikit-learn==1.3.0 \
    pandas==2.0.3 \
    numpy==1.24.3 \
    tensorflow==2.12.0 \
    xgboost==1.7.5 \
    lightgbm==3.3.5 \
    joblib==1.3.1 \
    boto3==1.28.0 \
    awscli==1.29.0 \
    fastapi==0.103.0 \
    uvicorn==0.23.2 \
    grpcio==1.58.0 \
    grpcio-tools==1.58.0 \
    protobuf==4.23.4

# Copy application code
COPY . .

# Copy models
RUN mkdir -p /app/models
COPY models/ /app/models/

# Create non-root user
RUN useradd -m -u 1000 rldb
USER rldb

# Expose gRPC port
EXPOSE 50051

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import grpc; print('gRPC OK')" || exit 1

# Run the AI service (gRPC server)
CMD ["python", "-m", "internal.service.ai.ai_server"]
