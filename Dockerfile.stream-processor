# Dockerfile para Stream Processor (processamento de streams Kinesis)
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Install dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the stream processor
RUN CGO_ENABLED=0 GOOS=linux go build -o /rldb-stream-processor ./internal/service/aws

# Runtime stage
FROM alpine:3.18

WORKDIR /app

# Install ca-certificates
RUN apk --no-cache add ca-certificates tzdata

# Install AWS CLI
RUN apk add --no-cache python3 py3-pip && \
    pip3 install --no-cache-dir awscli && \
    ln -s /usr/bin/aws /usr/local/bin/aws

# Copy binary from builder
COPY --from=builder /rldb-stream-processor /app/rldb-stream-processor

# Copy configuration
COPY .env ./

# Create non-root user
RUN adduser -D -u 1000 rldb
USER rldb

# Expose port (for health checks)
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8081/health || exit 1

# Run the stream processor
CMD ["/app/rldb-stream-processor"]
