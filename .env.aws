# RLDB API UNIVERSAL - AWS Configuration
# Este arquivo contem configuracoes para integracao com AWS

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
AWS_SESSION_TOKEN=${AWS_SESSION_TOKEN}
AWS_DEFAULT_REGION=us-east-1

# ============================================
# Kinesis Configuration
# ============================================
AWS_KINESIS_ENABLED=true
AWS_KINESIS_STREAM_NAME=rldb-transactions-stream
AWS_KINESIS_SHARD_COUNT=4
AWS_KINESIS_RETENTION_PERIOD=24
AWS_KINESIS_REGION=us-east-1

# ============================================
# DynamoDB Configuration
# ============================================
AWS_DYNAMODB_ENABLED=true
AWS_DYNAMODB_TABLE_NAME=rldb-transactions-table
AWS_DYNAMODB_REGION=us-east-1
AWS_DYNAMODB_READ_CAPACITY=100
AWS_DYNAMODB_WRITE_CAPACITY=100

# ============================================
# S3 Configuration
# ============================================
AWS_S3_ENABLED=true
AWS_S3_BUCKET=rldb-data-bucket
AWS_S3_REGION=us-east-1
AWS_S3_PREFIX=transactions

# ============================================
# Lambda Configuration
# ============================================
AWS_LAMBDA_ENABLED=true
AWS_LAMBDA_REGION=us-east-1
AWS_LAMBDA_MEMORY_SIZE=512
AWS_LAMBDA_TIMEOUT=30
AWS_LAMBDA_CONCURRENCY=100

# ============================================
# SageMaker Configuration
# ============================================
AWS_SAGEMAKER_ENABLED=true
AWS_SAGEMAKER_REGION=us-east-1
AWS_SAGEMAKER_ENDPOINT=
AWS_SAGEMAKER_MODEL=rldb-fraud-detection-model

# ============================================
# SNS Configuration
# ============================================
AWS_SNS_ENABLED=true
AWS_SNS_REGION=us-east-1
AWS_SNS_FRAUD_ALERT_ARN=arn:aws:sns:us-east-1:123456789012:rldb-fraud-alerts
AWS_SNS_NOTIFICATION_ARN=arn:aws:sns:us-east-1:123456789012:rldb-notifications

# ============================================
# CloudWatch Configuration
# ============================================
AWS_CLOUDWATCH_ENABLED=true
AWS_CLOUDWATCH_REGION=us-east-1
AWS_CLOUDWATCH_LOG_GROUP=/rldb/transactions

# ============================================
# SQS Configuration
# ============================================
AWS_SQS_ENABLED=true
AWS_SQS_REGION=us-east-1
AWS_SQS_QUEUE_NAME=rldb-processing-queue
AWS_SQS_MAX_RECEIVE_COUNT=3
AWS_SQS_VISIBILITY_TIMEOUT=30

# ============================================
# IA/ML Configuration
# ============================================
AI_FRAUD_DETECTION_ENABLED=true
AI_DEMAND_FORECAST_ENABLED=true
AI_ROUTE_OPTIMIZATION_ENABLED=true
AI_FRAUD_MODEL_THRESHOLD=0.7
AI_DEMAND_MODEL_THRESHOLD=0.8

# ============================================
# Real-time Processing Configuration
# ============================================
REAL_TIME_PROCESSING_ENABLED=true
BATCH_PROCESSING_ENABLED=false
BATCH_SIZE=100
BATCH_INTERVAL=5m

# ============================================
# LocalStack Configuration (para desenvolvimento)
# ============================================
LOCALSTACK_ENABLED=false
LOCALSTACK_HOST=localhost
LOCALSTACK_PORT=4566
LOCALSTACK_ENDPOINT=http://localhost:4566
